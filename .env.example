APP_ENV=development
LOG_LEVEL=INFO

# Replace these placeholders with each Pi's complete RTSP URL. Percent-encode
# special characters in credentials and keep real credentials only in .env.
CAMERA_1_SOURCE=rtsp://viewer:password@192.168.1.21:8554/camera
CAMERA_2_SOURCE=rtsp://viewer:password@192.168.1.22:8554/camera
CAMERA_3_SOURCE=rtsp://viewer:password@192.168.1.23:8554/camera
CAMERA_RECONNECT_DELAY_SECONDS=2
# Applied by OpenCV's FFmpeg backend when each RTSP source is opened.
CAMERA_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;udp|probesize;32|analyzeduration;0|fflags;nobuffer|flags;low_delay|reorder_queue_size;0
CAMERA_CAPTURE_OPEN_TIMEOUT_MS=5000
CAMERA_CAPTURE_READ_TIMEOUT_MS=1000
CAMERA_CAPTURE_BUFFER_SIZE=1
CAMERA_CAPTURE_DECODER_THREADS=1

MODEL_1_SOURCE_PATH=backend/models/weights/model_1.pt
MODEL_2_SOURCE_PATH=backend/models/weights/model_2.pt
MODEL_3_SOURCE_PATH=backend/models/weights/model_3.pt
MODEL_1_ENGINE_PATH=backend/models/weights/model_1.engine
MODEL_2_ENGINE_PATH=backend/models/weights/model_2.engine
MODEL_3_ENGINE_PATH=backend/models/weights/model_3.engine
MODEL_RUNTIME=tensorrt
MODEL_DEVICE=cuda:0
MODEL_CONFIDENCE_THRESHOLD=0.01
MODEL_IOU_THRESHOLD=0.50
MODEL_IMAGE_SIZE=640
MODEL_FOD_CLASS_ID=0
# Applied only after a complete cycle in which no camera has a newer frame.
INFERENCE_IDLE_BACKOFF_SECONDS=0.001

TEMPORAL_VALIDATION_ENABLED=true
TEMPORAL_WINDOW_SIZE=5
TEMPORAL_REQUIRED_HITS=3
TEMPORAL_MATCH_IOU=0.30

DATABASE_URL=sqlite:///./backend/data/fod.db
EVIDENCE_DIRECTORY=./backend/data/detections
STREAM_JPEG_QUALITY=80
FRONTEND_ORIGIN=http://localhost:5173
