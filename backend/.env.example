APP_ENV=development
LOG_LEVEL=INFO

CAMERA_MAX_COUNT=8
CAMERA_DISCOVERY_INTERVAL_SECONDS=2
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
CAMERA_RECONNECT_DELAY_SECONDS=2
CAMERA_STALE_TIMEOUT_SECONDS=5

MODEL_SOURCE_PATH=backend/models/weights/model_weight.pt
MODEL_ENGINE_PATH=backend/models/weights/model_weight.engine
MODEL_RUNTIME=auto
MODEL_DEVICE=cuda:0
MODEL_FALLBACK_DEVICE=cpu
MODEL_CONFIDENCE_THRESHOLD=0.01
MODEL_IOU_THRESHOLD=0.50
MODEL_IMAGE_SIZE=640

TEMPORAL_VALIDATION_ENABLED=true
TEMPORAL_WINDOW_SIZE=5
TEMPORAL_REQUIRED_HITS=3
TEMPORAL_MATCH_IOU=0.30

DATABASE_URL=sqlite:///./backend/data/fod.db
EVIDENCE_DIRECTORY=./backend/data/detections

STREAM_JPEG_QUALITY=80
FRONTEND_ORIGIN=http://localhost:5173
